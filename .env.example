# Copy to .env.local and set AZURE_STORAGE_SAS.
# .env.local is gitignored. Never commit a SAS token.

AZURE_STORAGE_ACCOUNT=gentlyinterview
AZURE_STORAGE_CONTAINERS=division-a,division-b,division-c

# Supplied to you before the session. Paste the query string, with or without a leading "?".
AZURE_STORAGE_SAS=

DATABASE_URL=postgres://postgres:postgres@localhost:5433/claims

# Set only if your network blocks Azure and we ask you to.
# USE_AZURITE=true
